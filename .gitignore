.ty_cache/
.hypothesis/
.desloppify/

# Node (mermaid doc checker tooling)
node_modules/

# Generated build info (baked into artifacts only; never committed)
/src/kdive/_buildinfo.py

# Build artifacts
/dist/
build/
!tests/providers/remote_libvirt/build/
*.egg-info/

# Live-stack report artifacts (default is out-of-tree; this guards a repo-local override).
# .live-stack-logs/ and .live-stack.pid are covered by the broader .live-* globs below.
kdive-live-stack-artifacts/
scorecard.png

# Agents and orchestration
.claude-flow/
.swarm/
# Per-agent git worktrees. Each holds a `.git` file pointing back at this repo, so an
# unqualified `git add` stages it as a broken gitlink; they also mask real untracked
# files in `git status`. `.claude/` itself stays tracked — it carries committed skills.
.claude/worktrees/

# Helm subchart tarballs — regenerated from Chart.lock by `helm dependency build`
# (the demo-only bundledBackends path); Chart.lock pins the exact versions/digests.
/deploy/helm/kdive/charts/

# Local live-run scratch (logs, pids, scratch build/components dirs).
# Covers .live-deploy/ (may embed backend credentials), .live-stack-logs/, .live-stack.pid, etc.
.live-*/
.live-*.pid

# Live-test systems descriptor — real per-environment facts (host FQDNs/IPs + secret refs).
# Root-level, gitignored; scaffold from the committed ./systems.toml.example.
/systems.toml

# Coverage-campaign run-local result artifacts (results.jsonl, grid.md, drivers, fetched certs)
/artifacts/coverage-campaign/

deploy/ansible/artifacts/

# mutation testing (scripts/mutate.py): mutmut's working/cache dir
/mutants/

# Transient OS files (never committed)
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
