KDIVE_EXTERNAL_BOOT_AUTHORITY_INSTANCE={{ provider_authority_host_instance }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_DENIED_IDENTITIES={{ provider_authority_host_denied_identities | join(',') }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_UID={{ provider_authority_host_uid }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_GID={{ provider_authority_host_gid }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_CLIENT_GID={{ provider_authority_host_client_gid }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_JOURNAL_DIR=/var/lib/kdive/provider-authority/journal
KDIVE_EXTERNAL_BOOT_AUTHORITY_REQUEST_SOCKET=/run/kdive/provider-authority/request/authority.sock
KDIVE_EXTERNAL_BOOT_AUTHORITY_PROVIDER_SOCKET=/run/kdive/provider-authority/libvirt/libvirt-sock
KDIVE_EXTERNAL_BOOT_AUTHORITY_REMOTE_MODULE_ENABLED={{ 'true' if provider_authority_host_remote_module_enabled | default(false) else 'false' }}
{% if provider_authority_host_remote_module_enabled | default(false) %}
KDIVE_EXTERNAL_BOOT_AUTHORITY_REMOTE_MODULE_ARCHITECTURES={{ provider_authority_host_remote_module_architectures | join(',') }}
KDIVE_REMOTE_LIBVIRT_STORAGE_POOL={{ provider_authority_host_remote_libvirt_storage_pool }}
{% endif %}
{% if provider_authority_host_network_address %}
KDIVE_EXTERNAL_BOOT_AUTHORITY_NETWORK_ADDRESS={{ provider_authority_host_network_address }}
KDIVE_EXTERNAL_BOOT_AUTHORITY_NETWORK_PORT={{ provider_authority_host_network_port }}
{% endif %}
{% if provider_authority_host_local_mutation_enabled | default(false) %}
KDIVE_LIBVIRT_RECOVERY_ROOT={{ provider_authority_host_recovery_root }}
KDIVE_LIBVIRT_ROOTFS_ROOT={{ provider_authority_host_rootfs_root }}
KDIVE_LIBVIRT_CONSOLE_ROOT={{ provider_authority_host_console_root }}
KDIVE_LIBVIRT_EXTERNAL_BOOT_CAPACITY_BYTES={{ provider_authority_host_external_boot_capacity_bytes }}
KDIVE_S3_ENDPOINT_URL={{ provider_authority_host_s3_endpoint_url }}
KDIVE_S3_BUCKET={{ provider_authority_host_s3_bucket }}
KDIVE_S3_REGION={{ provider_authority_host_s3_region }}
{% endif %}
