[Unit]
Description=KDIVE dormant external-boot provider authority
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target systemd-tmpfiles-setup.service

[Service]
Type=notify
NotifyAccess=main
User={{ live_vm_host_authority_account }}
Group={{ live_vm_host_authority_account }}
EnvironmentFile={{ live_vm_host_authority_environment }}
LoadCredential=database-dsn:{{ live_vm_host_authority_credentials_dir }}/database-dsn
LoadCredential=service-credential:{{ live_vm_host_authority_credentials_dir }}/service-credential
LoadCredential=server-certificate:{{ live_vm_host_authority_credentials_dir }}/server-certificate
LoadCredential=server-ca:{{ live_vm_host_authority_credentials_dir }}/server-ca
LoadCredential=worker-client-ca:{{ live_vm_host_authority_credentials_dir }}/worker-client-ca
LoadCredential=health-client-certificate:{{ live_vm_host_authority_credentials_dir }}/health-client-certificate
LoadCredential=health-client-key:{{ live_vm_host_authority_credentials_dir }}/health-client-key
{% if live_vm_host_authority_local_mutation_enabled | bool %}
LoadCredential=s3-credentials:{{ live_vm_host_authority_credentials_dir }}/s3-credentials
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/s3-credentials
{% endif %}
ExecStart={{ live_vm_host_authority_runtime_install }}/.venv/bin/python -m kdive external-boot-authority-host
Restart=on-failure
RestartSec=5s
WatchdogSec=90s
TimeoutStartSec=90s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices={{ 'no' if live_vm_host_authority_local_mutation_enabled | bool else 'yes' }}
{% if live_vm_host_authority_local_mutation_enabled | bool %}
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
{% endif %}
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/kdive/provider-authority/journal
ReadWritePaths=/run/kdive/provider-authority/request
{% if live_vm_host_authority_fault_proof_enabled | bool %}
ReadWritePaths=/run/kdive/provider-authority/proof-control
{% endif %}
{% if live_vm_host_authority_local_mutation_enabled | bool %}
ReadWritePaths={{ live_vm_host_authority_recovery_root }}
ReadWritePaths={{ live_vm_host_authority_rootfs_root }}
ReadWritePaths={{ live_vm_host_authority_console_root }}
{% endif %}

[Install]
WantedBy=multi-user.target
