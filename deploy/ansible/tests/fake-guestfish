#!/usr/bin/env bash
# Test double for `guestfish`, used only by the remote_libvirt_facts render harness
# (deploy/ansible/tests/run-remote-libvirt-facts-render.sh, issue #2160, ADR-0590).
#
# The role classifies three outcomes and must keep them apart: a conformant volume, a volume
# whose userland is absent, and a volume it could not inspect at all. Only the third is allowed
# to fail the play. Each shape below was observed from real guestfish 1.60.1 against purpose-built
# qcow2s before being reproduced here, so what the harness exercises is the role's classification
# of guestfish's actual contract, not a guess at it:
#
#   inspectable, both programs present  -> rc 0, one "true" per is-file on stdout
#   inspectable, a program absent       -> rc 0, "false" for that one            (still rc 0)
#   not inspectable (junk/empty/no OS)  -> rc 1, stdout EMPTY, message on stderr
#
# That stdout-is-empty-on-failure property is what lets the role tell "not there" from "could not
# look", so the double reproduces it exactly rather than approximating it.
#
# CI has no libguestfs and no bootable image, so the verdict comes from a sidecar file beside the
# volume rather than from the volume: <volume>.verdict holding `conformant`, `missing`, or
# `broken`. Absent sidecar means conformant, which keeps the pre-existing cases unchanged.
#
# Every invocation is logged so a case can assert the appliance did NOT run — that is the only
# way to prove the cache actually gates it.
set -uo pipefail

image=""
prev=""
for arg in "$@"; do
  [ "$prev" = "--add" ] && image="$arg"
  prev="$arg"
done

if [ -z "$image" ]; then
  echo "fake-guestfish: no --add argument in: $*" >&2
  exit 64
fi

printf '%s\n' "$image" >>"${FAKE_GUESTFISH_LOG:?fake-guestfish: FAKE_GUESTFISH_LOG unset}"

# One reply per `is-file` command on stdin, mirroring real guestfish's one-line-per-command output.
programs=0
while IFS= read -r line; do
  case "$line" in
  "is-file "*) programs=$((programs + 1)) ;;
  esac
done

verdict="conformant"
[ -f "$image.verdict" ] && verdict="$(cat "$image.verdict")"

case "$verdict" in
conformant)
  for ((i = 0; i < programs; i++)); do echo "true"; done
  ;;
missing)
  # First program present, the rest absent: a partial userland must fail the same as none of it.
  for ((i = 0; i < programs; i++)); do
    if [ "$i" -eq 0 ]; then echo "true"; else echo "false"; fi
  done
  ;;
broken)
  echo "libguestfs: error: could not create appliance through libvirt" >&2
  exit 1
  ;;
*)
  echo "fake-guestfish: unknown verdict '$verdict' in $image.verdict" >&2
  exit 64
  ;;
esac
