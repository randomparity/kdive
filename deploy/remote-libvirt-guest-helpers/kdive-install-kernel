#!/bin/bash
# kdive-install-kernel — operator-provided in-guest helper (ADR-0082 §1 contract).
#
# Reference implementation for a Fedora (BLS + grubby + grub2-reboot) remote-libvirt base image.
# The remote-libvirt Install/Boot plane allowlists EXACTLY this program at
# /usr/local/sbin/kdive-install-kernel and invokes it with fixed argv (never a shell string).
#
# Subcommands:
#   install --url <presigned-get> --cmdline <cmdline> --method <method>
#       curl the ADR-0081 gzip bundle (boot/vmlinuz + lib/modules/<ver>), install it, and
#       add-or-replace ONE deterministic grub slot (title "kdive") with <cmdline> verbatim.
#       Does NOT change the boot selection. method=kdump also enables the kdump service.
#       Idempotent: re-running converges to the same /boot + grub state.
#   boot-id
#       print /proc/sys/kernel/random/boot_id (the kernel-minted per-boot UUID).
#   boot
#       select the "kdive" slot for the NEXT boot only (grub one-shot) AND trigger a detached
#       reboot into it, atomically.
#
# Exit-code contract (ADR-0489). The worker maps each code onto a failure category, and the
# category decides whether the job may be retried:
#   0   success
#   75  EX_TEMPFAIL — the bundle could not be fetched from the presigned URL. Transient: the
#       object store blipped, the guest network was not settled, or the URL had expired. A retry
#       mints a fresh URL and can succeed, so the worker reads this as infrastructure_failure.
#   1   any other failure this helper decides — bad argv, a bundle whose contents are wrong,
#       extract/depmod/dracut/grubby/grub2-reboot. Deterministic: a bare retry cannot fix it.
#   *   any other non-zero (a `set -e` propagation from an unguarded command) is deterministic
#       too; the worker maps every unrecognised code to install_failure.
# Codes are ADDITIVE to this contract: the worker treats an unknown one as deterministic, so an
# image built before this contract existed (exit 1 for everything) keeps its old behaviour.
set -euo pipefail

KDIVE_TITLE="kdive"
readonly EX_DETERMINISTIC=1
readonly EX_TEMPFAIL=75

die() {
  echo "kdive-install-kernel: $*" >&2
  exit "$EX_DETERMINISTIC"
}

# A failure a bare retry can heal: the worker re-mints the presigned URL and runs install again.
die_tempfail() {
  echo "kdive-install-kernel: $*" >&2
  exit "$EX_TEMPFAIL"
}

# Remove every existing grub entry titled "kdive" so install replaces a single slot.
remove_kdive_slot() {
  # grubby indexes BLS entries; iterate titles and remove matching kernels by path.
  local idx kernel
  while read -r idx; do
    [ -n "$idx" ] || continue
    kernel="$(grubby --info="$idx" 2>/dev/null | sed -n 's/^kernel="\?\([^"]*\)"\?/\1/p')"
    [ -n "$kernel" ] && grubby --remove-kernel="$kernel" >/dev/null 2>&1 || true
  done < <(grubby --info=ALL 2>/dev/null | awk -F\" -v t="$KDIVE_TITLE" '/^title=/{ if ($2==t) print NR }' | sed 's/[^0-9]//g')
}

do_install() {
  local url="" cmdline="" method=""
  while [ $# -gt 0 ]; do
    case "$1" in
    --url)
      url="$2"
      shift 2
      ;;
    --cmdline)
      cmdline="$2"
      shift 2
      ;;
    --method)
      method="$2"
      shift 2
      ;;
    *) die "unknown install arg: $1" ;;
    esac
  done
  [ -n "$url" ] || die "install requires --url"
  [ -n "$cmdline" ] || die "install requires --cmdline"

  local tmp
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN

  # curl's own --retry covers seconds; it does not cover an object store that is restarting or a
  # presigned URL that has already expired. Those need the worker's retry, which mints a new URL.
  curl -fsSL --retry 3 "$url" -o "$tmp/bundle.tar.gz" || die_tempfail "bundle download failed"
  # Deterministic, not tempfail: curl already fails a short transfer, so bytes that arrived whole
  # and still will not extract are a bad object, and re-downloading them yields the same bytes.
  tar xzf "$tmp/bundle.tar.gz" -C "$tmp" || die "bundle extract failed"
  [ -f "$tmp/boot/vmlinuz" ] || die "bundle missing boot/vmlinuz"
  [ -d "$tmp/lib/modules" ] || die "bundle missing lib/modules"

  local ver
  ver="$(find "$tmp/lib/modules" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | head -n1)"
  [ -n "$ver" ] || die "no kernel version in lib/modules"

  install -m 0644 "$tmp/boot/vmlinuz" "/boot/vmlinuz-$ver"
  rm -rf "/lib/modules/$ver"
  cp -a "$tmp/lib/modules/$ver" "/lib/modules/$ver"
  depmod "$ver"
  dracut --force "/boot/initramfs-$ver.img" "$ver" || die "dracut failed for $ver"

  remove_kdive_slot
  grubby --add-kernel="/boot/vmlinuz-$ver" \
    --initrd="/boot/initramfs-$ver.img" \
    --title="$KDIVE_TITLE" \
    --args="$cmdline" \
    --copy-default || die "grubby add-kernel failed"

  if [ "$method" = "kdump" ]; then
    systemctl enable kdump.service >/dev/null 2>&1 || true
  fi
  echo "installed kernel $ver into the kdive slot"
}

do_boot() {
  # Find the kdive entry's grub id/index and set it as the one-shot next-boot target.
  grub2-reboot "$KDIVE_TITLE" || die "grub2-reboot could not select the kdive slot"
  # Detached reboot: return before the guest-agent is torn down (ADR-0082 §1/§3).
  systemd-run --on-active=2 systemctl reboot >/dev/null 2>&1 ||
    (setsid bash -c 'sleep 2; systemctl reboot' >/dev/null 2>&1 </dev/null &)
  echo "kdive slot selected for next boot; reboot scheduled"
}

# Report whether this guest reserved crashkernel memory and whether the capture kernel is
# actually loaded. The caller gates runs.boot on this: arming happens well after the guest
# is otherwise up (the in-guest kdump service builds a dracut initramfs first), and crashing
# an unarmed guest yields no vmcore. Read through the helper because the guest-agent exec
# surface is allowlisted to these helpers -- a raw `cat` is refused.
do_kdump_status() {
  printf 'crash_size=%s\n' "$(cat /sys/kernel/kexec_crash_size 2>/dev/null || echo 0)"
  printf 'crash_loaded=%s\n' "$(cat /sys/kernel/kexec_crash_loaded 2>/dev/null || echo 0)"
}

cmd="${1:-}"
shift || true
case "$cmd" in
install) do_install "$@" ;;
boot-id) cat /proc/sys/kernel/random/boot_id ;;
boot) do_boot ;;
kdump-status) do_kdump_status ;;
*) die "unknown subcommand: ${cmd:-<none>} (expected install|boot-id|boot|kdump-status)" ;;
esac
