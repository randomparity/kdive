<domain type="kvm">
  <name>kdive-module-appliance-v1</name>
  <memory unit="MiB">512</memory>
  <vcpu placement="static">1</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <kernel>/var/lib/libvirt/kdive/module-appliance/v1/x86_64/image/vmlinuz</kernel>
    <initrd>/var/lib/libvirt/kdive/module-appliance/v1/x86_64/image/initramfs.cpio</initrd>
    <cmdline>console=hvc0 panic=-1</cmdline>
  </os>
  <features><acpi/></features>
  <clock offset="utc"/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type="volume" device="disk">
      <driver name="qemu" type="qcow2" cache="none" io="native"/>
      <source pool="KDIVE_ROOT_POOL" volume="KDIVE_ROOT_VOLUME"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <disk type="volume" device="disk">
      <driver name="qemu" type="raw" cache="none" io="native"/>
      <source pool="KDIVE_SOURCE_POOL" volume="KDIVE_SOURCE_VOLUME"/>
      <target dev="vdb" bus="virtio"/>
      <readonly/>
    </disk>
    <disk type="volume" device="disk">
      <driver name="qemu" type="raw" cache="none" io="native"/>
      <source pool="KDIVE_SCRATCH_POOL" volume="KDIVE_SCRATCH_VOLUME"/>
      <target dev="vdc" bus="virtio"/>
    </disk>
    <console type="pty"><target type="virtio" port="0"/></console>
    <memballoon model="none"/>
  </devices>
</domain>
