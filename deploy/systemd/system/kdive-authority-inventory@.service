[Unit]
Description=KDIVE one-shot proof inventory
PartOf=kdive-authority-inventory.socket
# Requisite, not Requires: a connection fails rather than starting a stopped or failed authority.
Requisite=kdive-external-boot-authority.service
After=kdive-external-boot-authority.service

[Service]
Type=exec
User=kdive-provider-authority
Group=kdive-provider-authority
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/nonexistent LC_ALL=C.UTF-8 /opt/kdive-authority-inventory/.venv/bin/python -I /opt/kdive-authority-inventory/collector.py
WorkingDirectory=/
RuntimeMaxSec=120s
TimeoutStopSec=1s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
InaccessiblePaths=-/etc/kdive/credentials/provider-authority -/var/lib/kdive/provider-authority/journal -/run/kdive/provider-authority/proof-control
